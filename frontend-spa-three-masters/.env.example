# URL del backend Express. Debe terminar en /api y no llevar barra final.
# Local:
VITE_API_URL=http://localhost:4000/api

# Producción (Vercel): se configura en Project Settings > Environment Variables
# y debe quedar así antes del build, porque Vite la incrusta en el bundle:
# VITE_API_URL=https://tu-backend.onrender.com/api
