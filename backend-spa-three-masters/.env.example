# Puerto del servidor
PORT=4000

# MongoDB local o MongoDB Atlas
MONGO_URI=mongodb://127.0.0.1:27017/three-masters

# Autenticación JWT (obligatorio, mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRA=8h

# Orígenes permitidos por CORS, separados por coma
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary: almacenamiento de imágenes del catálogo y del equipo
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
