# Copia este archivo como .env y completa los valores.
# Nunca subas el .env real al repositorio.

PORT=4000
MONGO_URI=mongodb://127.0.0.1:27017/three-masters

# Secreto para firmar los JWT. Usa una cadena larga y aleatoria.
# Ejemplo para generarlo: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=1c3c10d554f4e146bcf72f207880569ed3c4bdbe9e8ec10850980e05e3ae02df
JWT_EXPIRA=8h

# Orígenes permitidos por CORS, separados por coma.
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# Solo para el script npm run seed:admin (crear el primer administrador).
ADMIN_CORREO=admin@example.com
ADMIN_CONTRASENA=cambia-esta-contrasena
ADMIN_NOMBREUSUARIO=admin
ADMIN_NOMBRECOMPLETO=Administradora Three Masters
ADMIN_TELEFONO=3001234567
