# Puerto del servidor (Render/Railway lo asignan solos: no lo fijes en producción)
PORT=4000

# MongoDB local o MongoDB Atlas. En producción usa la cadena mongodb+srv://
# que entrega Atlas, terminada en el nombre de la base: /three-masters
MONGO_URI=mongodb://127.0.0.1:27017/three-masters

# Zona horaria del salón. Las citas se comparan contra la fecha y hora local
# del servidor; el hosting en la nube corre en UTC, así que fija Bogotá.
TZ=America/Bogota

# Autenticación JWT (obligatorio, mínimo 32 caracteres)
JWT_SECRET=cambia-esto-por-un-secreto-largo-y-aleatorio
JWT_EXPIRA=8h

# Orígenes permitidos por CORS, separados por coma.
# En producción: el dominio del frontend (https://tu-app.vercel.app)
CORS_ORIGENES=http://localhost:5173,http://127.0.0.1:5173

# Cloudinary: almacenamiento de imágenes del catálogo y del equipo
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Siembra inicial del administrador. Solo los usa `npm run seed:admin`;
# el servidor no los necesita para arrancar.
ADMIN_CORREO=
ADMIN_CONTRASENA=
ADMIN_NOMBREUSUARIO=
ADMIN_NOMBRECOMPLETO=
# Celular de 10 dígitos, solo números (ej. 3123456789)
ADMIN_TELEFONO=
